# Server-only bench settings. The bench API runs in development mode.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=talazo_local
TALAZO_DEVICE_ID=talazo-esp32-01
TALAZO_DEVICE_KEY=

# Enable the private tools at /internal/farmer/monitoring on this desktop only.
TALAZO_INTERNAL_TOOLS=false

# Public Supabase configuration (publishable key only; never use a secret here).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key for the read-only inventory script; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server-side Supabase project URL (same project as PUBLIC_SUPABASE_URL).
SUPABASE_URL=

# Farmonaut: private server-only credential. Never prefix with PUBLIC_.
FARMONAUT_API_KEY=
# Talazo integration setting: send isTesting:true on every provider request.
# Sample responses must remain separate from real farmer observations.
FARMONAUT_TEST_MODE=true

# Hosted application URL used in invitation links; set HTTPS before production.
ORIGIN=http://127.0.0.1:5174
# Optional automated invitation email; otherwise admins can share access links.
RESEND_API_KEY=
INVITATION_FROM=
# Direct/pooler PostgreSQL URL for applying the additive pilot migration.
SUPABASE_DB_URL=
# Long random server-only secret for POST /api/satellite/sync scheduler calls.
SATELLITE_JOB_SECRET=

# Google Maps JavaScript API browser key. Restrict to your website origins and Maps JavaScript API.
PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional approved field for the read-only live-monitoring integration script.
TALAZO_QA_ZONE_ID=
